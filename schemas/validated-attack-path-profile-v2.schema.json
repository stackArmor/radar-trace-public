{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:radar-trace:schema:validated-attack-path-profile:v2",
  "title": "Validated RADAR TRACE attack-path profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "reviewRecommended",
    "reviewReasons",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "validated-attack-path-profile/v2"
    },
    "profile": {
      "$ref": "urn:radar-trace:schema:attack-path-profile:v2"
    },
    "reviewRecommended": {
      "type": "boolean",
      "description": "True when a valid profile contains low-confidence, unknown, or contradictory material that warrants analyst review."
    },
    "reviewReasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "$ref": "urn:radar-trace:schema:attack-path-profile:v2#/$defs/provenance"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reviewRecommended": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "reviewReasons": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "reviewReasons": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
